  logging {                                                                                                                                                                  
      channel b_stdout {                                
          stderr;                                                                                                                                                            
          severity info;                                
          print-category yes;
          print-severity yes;
          print-time yes;
      };
      category default { b_stdout; };
      category config  { b_stdout; };                                                                                                                                        
      category queries { b_stdout; };
  };                                                                                                                                                                         
                                                        
  options {
      directory "/var/cache/bind";
      recursion yes;
      allow-query { any; };
      listen-on { any; };
      listen-on-v6 { any; };                                                                                                                                                 
   
      forwarders {                                                                                                                                                           
          {{ dns_forwarder | default('10.47.242.10') }};
      };                                                                                                                                                                     
   
      forward first;                                                                                                                                                         
  };                                                    

  zone "{{ dns_zone | default('telcov10n.lab.eng.tlv2.redhat.com') }}" {                                                                                                     
      type master;
      file "/etc/bind/zones/db.{{ dns_zone | default('telcov10n') }}";                                                                                                       
  }; 